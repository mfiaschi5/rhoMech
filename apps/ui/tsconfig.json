{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"],
    "paths": {
      "@ksmech/viz": ["../../packages/viz/src/index.ts"],
      "@ksmech/viz/scene.schema.json": ["../../packages/viz/scene.schema.json"],
      "@ksmech/viz/*": ["../../packages/viz/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@rdkit/rdkit": ["./node_modules/@rdkit/rdkit"],
      "3dmol": ["./node_modules/3dmol"]
    }
  },
  "include": ["src", "e2e", "scripts", "../../packages/viz/src"]
}
