{
  "name": "ksmech-ui",
  "version": "0.1.0",
  "private": true,
  "description": "ksmech-serve frontend: predict, correct, curate and browse mechanisms",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "predev": "node scripts/vendor.mjs",
    "prebuild": "node scripts/vendor.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./scripts/viz-node-hooks.mjs --test --test-concurrency=2 \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"../../packages/viz/src/**/*.test.ts\"",
    "scene:export": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./scripts/viz-node-hooks.mjs scripts/scene-export.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@rdkit/rdkit": "2026.9.1",
    "3dmol": "2.5.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
